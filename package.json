{
  "name": "termshot",
  "version": "0.7.0",
  "description": "CLI tool for AI coding agents. Runs a command in a built-in headless terminal, renders it to a PNG, and prints a JSON record with a sha256.",
  "keywords": [
    "ai-agents",
    "agent-tools",
    "claude-code",
    "codex",
    "antigravity",
    "grok-cli",
    "cursor",
    "opencode",
    "agentic",
    "cli",
    "terminal",
    "screenshot",
    "headless",
    "macos",
    "pr-evidence"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "termshot": "dist/termshot"
  },
  "files": [
    "src",
    "assets",
    "dist"
  ],
  "scripts": {
    "build": "bun build --compile ./src/cli.ts --outfile dist/termshot",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "@xterm/headless": "6.0.0"
  }
}
