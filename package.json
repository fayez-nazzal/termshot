{
  "name": "termshot",
  "version": "0.6.1",
  "description": "CLI tool for AI coding agents. Runs a command in a fresh Ghostty or Alacritty window, captures it to a PNG, and prints a JSON record with a sha256.",
  "keywords": [
    "ai-agents",
    "agent-tools",
    "claude-code",
    "codex",
    "antigravity",
    "grok-cli",
    "cursor",
    "opencode",
    "agentic",
    "cli",
    "terminal",
    "screenshot",
    "ghostty",
    "alacritty",
    "macos",
    "screencapture",
    "pr-evidence"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "termshot": "dist/termshot"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "bun build --compile ./src/cli.ts --outfile dist/termshot",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
